#!/bin/sh
# plain installer: curl -fsSL https://getplain.org/install | sh
# Puts the latest release in ~/.plain/bin (or $PLAIN_DIR) and adds that to your shell's PATH.
set -eu

repo=backmeupplz/plain
case "$(uname -s)/$(uname -m)" in
  Darwin/arm64) target=aarch64-apple-darwin ;;
  Darwin/x86_64) target=x86_64-apple-darwin ;;
  Linux/x86_64 | Linux/amd64) target=x86_64-unknown-linux-gnu ;;
  *)
    echo "plain has no prebuilt binary for $(uname -s) $(uname -m) yet." >&2
    echo "Build it from source instead: cargo install --git https://github.com/$repo" >&2
    exit 1
    ;;
esac

dir="${PLAIN_DIR:-$HOME/.plain/bin}"
mkdir -p "$dir"
base="https://github.com/$repo/releases/latest/download"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
echo "downloading $base/plain-$target.tar.gz"
curl -fsSL -o "$tmp/plain-$target.tar.gz" "$base/plain-$target.tar.gz"
# the release's SHA256SUMS: a download that doesn't match it never gets unpacked
curl -fsSL -o "$tmp/SHA256SUMS" "$base/SHA256SUMS"
if command -v sha256sum >/dev/null 2>&1; then sum="sha256sum"; else sum="shasum -a 256"; fi
# compared by hand: some sha256sum -c pass on empty input, so a missing line would skip the check
want="$(grep " plain-$target.tar.gz\$" "$tmp/SHA256SUMS" | cut -d' ' -f1)"
got="$($sum "$tmp/plain-$target.tar.gz" | cut -d' ' -f1)"
[ -n "$want" ] && [ "$want" = "$got" ] || {
  echo "plain-$target.tar.gz doesn't match the release's SHA256SUMS; nothing was installed" >&2
  exit 1
}
tar -xzf "$tmp/plain-$target.tar.gz" -C "$dir"
chmod +x "$dir/plain"
echo "installed $("$dir/plain" --version) to $dir/plain"

case ":$PATH:" in
  *":$dir:"*) exit 0 ;;
esac
line="export PATH=\"$dir:\$PATH\""
case "${SHELL:-}" in
  */zsh) rc="$HOME/.zshrc" ;;
  */bash) if [ "$(uname -s)" = Darwin ]; then rc="$HOME/.bash_profile"; else rc="$HOME/.bashrc"; fi ;;
  */fish)
    rc=""
    mkdir -p "$HOME/.config/fish/conf.d"
    echo "fish_add_path $dir" > "$HOME/.config/fish/conf.d/plain.fish"
    ;;
  *) rc="$HOME/.profile" ;;
esac
if [ -n "$rc" ] && ! grep -qsF "$line" "$rc"; then
  printf '\n# plain\n%s\n' "$line" >> "$rc"
  echo "added $dir to PATH in $rc"
fi
echo "open a new terminal (or run: $line), then try: plain init && plain test"
